{
  "name": "@hearth/local-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs Hearth end to end on one machine: emulated IoT Core broker (mTLS + policy ACLs), rule, DynamoDB and skill",
  "exports": {
    ".": "./src/index.ts",
    "./test-certs": "./src/testCerts.ts",
    "./bus": "./src/bus.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "broker": "tsx src/cli/broker.ts",
    "bus": "tsx src/cli/bus.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1153.0",
    "@hearth/contracts": "workspace:*",
    "@hearth/skill": "workspace:*",
    "aedes": "^1.2.0",
    "dynalite": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ask-sdk-model": "^1.86.0",
    "mqtt": "^5.16.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
