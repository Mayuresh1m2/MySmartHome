# Hearth: per-person settings. Copy to .env (gitignored) and fill in:
#   cp .env.example .env && scripts/configure.sh
# Comments must be on their own lines.

# --- Alerts -----------------------------------------------------------------
# Kill switches, budget and Lambda error alarm emails go here.
HEARTH_ALERT_EMAIL=

# --- AWS (hearth-aws) ---------------------------------------------------------
# The AWS CLI profile to use (aws login --profile hearth, or aws configure sso / aws configure).
AWS_PROFILE=hearth
# Where Hearth's AWS side lives. New sign-up experience: settings.aws.com → Project → Overview → Region
# (India → ap-southeast-2, US → us-east-2, Europe → eu-north-1). Classic accounts: any region.
HEARTH_AWS_REGION=ap-southeast-2
# The IoT Core ATS data endpoint for that region. scripts/configure.sh fills this in.
HEARTH_IOT_ENDPOINT=
# The Alexa skill ID (amzn1.ask.skill.…), set after creating the skill.
HEARTH_SKILL_ID=
# Must match your Echo's language (Alexa app → Devices → your Echo → Language).
HEARTH_LOCALE=en-IN
# How long the Lambda waits for the hub (ms, never above 5000). 5000 with a local model.
HEARTH_REPLY_TIMEOUT_MS=5000
# Automatic kill switches (USD of actual monthly cost): Hearth-tagged costs, and the whole account.
HEARTH_KILL_SWITCH_USD=1
HEARTH_ACCOUNT_KILL_SWITCH_USD=5
# Log utterance text in the skill's logs (normally false).
HEARTH_DEBUG_UTTERANCES=false

# --- Hub ---------------------------------------------------------------------
# Lowercase letters, digits and hyphens. Becomes the IoT thing hearth-<id>.
HEARTH_HUB_ID=laptop
# Local model the hub uses through Ollama.
HEARTH_OLLAMA_MODEL=qwen2.5:3b
