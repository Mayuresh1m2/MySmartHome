# Dreamehome credentials for the vacuum adapter.
# Copy to  hearth-devices/secrets/dreame.env  (gitignored), fill in, chmod 600.
# Claude does not read this file; it is sourced into the process env by scripts/run.sh.
DREAME_USERNAME=
# Password is used ONCE to mint a revocable token, then it's no longer needed. It is never
# written to disk. After the first successful run you can blank this line out again.
DREAME_PASSWORD=
# Region/server code. Leave blank to auto-try sg,in,eu,us,cn. India is usually sg or in.
DREAME_COUNTRY=
# Target MAC as Dreamehome reports it (format AA:BB:CC:DD:EE:FF). Optional: with a single
# device on the account the probe uses it automatically. Find it in the Dreame app or the
# probe's device list; it stays in your gitignored secrets/dreame.env, never in a committed file.
DREAME_MAC=
