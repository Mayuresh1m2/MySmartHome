# Copy to config/hub.env. Values from the hearth-aws handoff (out/hub.env): IOT_ENDPOINT, HUB_ID, AWS_REGION.
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.eu-west-1.amazonaws.com
HUB_ID=laptop
AWS_REGION=eu-west-1
OLLAMA_MODEL=
# Optional
# INTENT=keyword            # keyword | ollama
# HEALTH_PORT=8787          # 127.0.0.1 only
# AUDIT_TEXT=true           # false logs only the utterance length
# LOG_LEVEL=info
# CERT_FILE=                # override certs/hub.crt (local-stack uses its own CA-signed cert)
# CA_FILE=                  # override certs/AmazonRootCA1.pem
# MQTT_PORT=8883
# DEVICES=json             # json: config/devices.json | mqtt: hearth-devices via its core
# DEVICES_BUS_URL=mqtt://127.0.0.1:1883
# DEVICES_BUS_USER=hub
# DEVICES_BUS_PASSWORD=     # the hub's bus password (keep only in config/hub.env)
# INTENT_TIMEOUT_MS=4000
