{
  "name": "@hearth/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hearth hub: relays Alexa commands from AWS IoT Core to allowlisted local tools",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts | pino-pretty",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "try": "tsx src/cli/try.ts",
    "eval": "tsx test/evals/run.ts"
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "ollama": "^0.6.4",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "@hearth/contracts": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@hearth/local-stack": "workspace:*",
    "@types/node": "^22.20.5",
    "aedes": "^1.2.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
