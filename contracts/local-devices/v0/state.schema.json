{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearth.local/contracts/local-devices/v0/state.schema.json",
  "title": "Device state, retained, topic hearth/local/devices/<deviceId>/state",
  "type": "object",
  "required": ["v", "online", "updatedAt"],
  "properties": {
    "v": { "const": 0 },
    "online": { "type": "boolean" },
    "updatedAt": { "type": "integer", "minimum": 0 }
